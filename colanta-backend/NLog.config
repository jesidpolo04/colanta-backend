<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<targets>

		<target name="giftcard_debug" xsi:type="File" fileName="logs/giftcards_debug.txt" />
		<target name="promotions_debug" xsi:type="File" fileName="logs/promotions_debug.txt" />
		<target name="categories" xsi:type="File" fileName="logs/categories.txt" />
		<target name="cupo_lacteo_debug" xsi:type="File" fileName="logs/cupo_lacteo_debug.txt" />
		<target name="orders_debug" xsi:type="File" fileName="logs/orders_debug.txt" />
		<target name="taxes_debug" xsi:type="File" fileName="logs/taxes_debug.txt" />
		<target name="order_observations_error" xsi:type="File"
			fileName="logs/order_observations_error.txt" />
		<target name="inventories_debug" xsi:type="File" fileName="logs/inventories_debug.txt" />
		<!-- Controladores -->
		<target name="promotions_controller_file" xsi:type="File"
			fileName="logs/promotions_controller.log" />

		<!-- Jobs -->
		<target name="clean_expired_promotions_file" xsi:type="File"
			fileName="logs/jobs/clean_expired_promotions.log" />
		<target name="logconsole" xsi:type="Console" />
	</targets>

	<rules>
		<logger name="colanta_backend.App.GiftCards.*" minlevel="Debug" writeTo="giftcard_debug" />
		<logger name="colanta_backend.App.Credits.*" minlevel="Debug" writeTo="cupo_lacteo_debug" />
		<logger name="colanta_backend.App.Inventory.*" minlevel="Trace" writeTo="inventories_debug" />
		<logger name="colanta_backend.App.Categories.*" minLevel="Debug" writeTo="categories" />
		<logger name="colanta_backend.App.Promotions.*" minLevel="Debug" writeTo="promotions_debug" />
		<logger name="colanta_backend.App.Orders.*" minlevel="Debug" writeTo="orders_debug" />
		<logger name="colanta_backend.App.Taxes.*" minlevel="Debug" writeTo="taxes_debug" />
		<logger name="colanta_backend.App.OrderObservations.*" minlevel="Error"
			writeTo="order_observations_errors" />

		<!-- Controladores -->
		<logger name="colanta_backend.App.Promotions.Presentation.PromotionsController"
			minlevel="Trace" writeTo="promotions_controller_file" />

		<!-- Jobs -->
		<logger name="colanta_backend.App.Promotions.Jobs.CleanFixedPricesFromExpiredPromotion"
			minlevel="Trace" writeTo="clean_expired_promotions_file" />
	</rules>
</nlog>